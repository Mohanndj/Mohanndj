<?xml version="1.0" encoding="utf-8"?>
<!-- the widget «اليوم» (v116): four cells by two at first, made larger or smaller by the owner; drawn again every half
     hour at most when nothing else asks (the page sends its lists, a tick, the new day's alarm) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_desc"
    android:initialLayout="@layout/widget_today"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="80dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_today"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
